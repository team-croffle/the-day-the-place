{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayplace",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}

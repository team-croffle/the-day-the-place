{
  "name": "nest-vue",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Vue 3 pnpm monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter @nest-vue/server --filter @nest-vue/web dev",
    "dev:server": "pnpm --filter @nest-vue/server dev",
    "dev:web": "pnpm --filter @nest-vue/web dev",
    "build": "pnpm --filter @nest-vue/server build && pnpm --filter @nest-vue/web build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:py": "uv run --directory collector --frozen mypy",
    "test": "pnpm --filter @nest-vue/server test",
    "test:py": "uv run --directory collector --frozen pytest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:py": "uv run --directory collector --frozen ruff check .",
    "lint:py:fix": "uv run --directory collector --frozen ruff check --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:py": "uv run --directory collector --frozen ruff format .",
    "db:generate": "pnpm --filter @nest-vue/server db:generate",
    "db:migrate": "pnpm --filter @nest-vue/server db:migrate",
    "db:push": "pnpm --filter @nest-vue/server db:push",
    "db:studio": "pnpm --filter @nest-vue/server db:studio",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yaml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yaml down",
    "docker:prod": "docker compose -f docker/docker-compose.yaml up -d --build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0"
}
